# Content system: large or transient files
content/posts/*/images/src/
content/posts/*/reference-only/
content/posts/*/02-research/pages/
content-system/seo/firecrawl-map-latest.json
content-system/seo/traffic-latest.json

# Never commit keys or connector config with secrets
# .mcp.json is committed on purpose: it only names variables, the values live in environment secrets
*service-account*.json
gsc-key*.json
.env
