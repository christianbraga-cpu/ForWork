{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "payloads/measurement_plan.schema.json",
  "type": "object",
  "required": [
    "kpis",
    "review_date",
    "crm_report",
    "persona_predictions"
  ],
  "properties": {
    "kpis": {
      "type": "array"
    },
    "review_date": {
      "type": "string"
    },
    "crm_report": {
      "type": "object"
    },
    "persona_predictions": {
      "type": "array"
    },
    "crm_fields_to_backfill": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}