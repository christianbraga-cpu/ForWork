{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "payloads/build_report.schema.json",
  "type": "object",
  "required": [
    "files_written",
    "schema_types",
    "automated_checks",
    "screenshots",
    "lighthouse",
    "noindex",
    "issues"
  ],
  "properties": {
    "files_written": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "schema_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "automated_checks": {
      "type": "string"
    },
    "screenshots": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lighthouse": {},
    "noindex": {
      "type": "boolean"
    },
    "issues": {
      "type": "array"
    }
  }
}