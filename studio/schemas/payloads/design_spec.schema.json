{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "payloads/design_spec.schema.json",
  "type": "object",
  "required": [
    "sections",
    "cta_plan",
    "form_spec",
    "mobile",
    "accessibility"
  ],
  "properties": {
    "template": {
      "type": "string"
    },
    "sections": {
      "type": "array"
    },
    "cta_plan": {
      "type": "object"
    },
    "form_spec": {
      "type": "object",
      "required": [
        "fields",
        "hidden_fields",
        "action"
      ],
      "properties": {
        "fields": {
          "type": "array"
        },
        "hidden_fields": {
          "type": "array"
        },
        "action": {
          "type": "string"
        }
      }
    },
    "mobile": {
      "type": "object"
    },
    "accessibility": {
      "type": "object"
    },
    "copy_limits": {
      "type": "object"
    }
  }
}