{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "payloads/content_brief.schema.json",
  "type": "object",
  "required": [
    "url",
    "primary_keyword",
    "title_draft",
    "meta_description_draft",
    "h1",
    "audience",
    "intent",
    "section_outline",
    "questions_to_answer",
    "link_plan",
    "schema_types",
    "word_count_range"
  ],
  "properties": {
    "url": {
      "type": "string"
    },
    "primary_keyword": {
      "type": "string"
    },
    "secondary_keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "title_draft": {
      "type": "string"
    },
    "meta_description_draft": {
      "type": "string"
    },
    "h1": {
      "type": "string"
    },
    "audience": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "intent": {
      "type": "string"
    },
    "section_outline": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "heading_intent",
          "must_answer"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "heading_intent": {
            "type": "string"
          },
          "must_answer": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fact_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "questions_to_answer": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "link_plan": {
      "type": "object",
      "required": [
        "must_link_to"
      ],
      "properties": {
        "must_link_to": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "url",
              "anchor_options"
            ],
            "properties": {
              "url": {
                "type": "string"
              },
              "anchor_options": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "placement": {
                "type": "string"
              }
            }
          }
        },
        "should_receive_links_from": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "external_sources": {
          "type": "array"
        },
        "max_internal_links": {
          "type": "integer"
        }
      }
    },
    "schema_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "word_count_range": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "competitors_to_beat": {
      "type": "array"
    },
    "structure_changes": {
      "type": "array"
    }
  }
}