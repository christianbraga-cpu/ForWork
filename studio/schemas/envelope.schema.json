{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "envelope.schema.json",
  "title": "Page Studio handoff envelope",
  "type": "object",
  "required": [
    "envelope_version",
    "run_id",
    "stage",
    "from_agent",
    "to_agents",
    "status",
    "revision",
    "inputs_consumed",
    "payload_type",
    "payload",
    "self_qa",
    "assumptions",
    "open_questions",
    "confidence",
    "timestamp"
  ],
  "properties": {
    "envelope_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 3
    },
    "stage": {
      "enum": [
        "research",
        "architecture",
        "persona_brief",
        "content",
        "persona_copy",
        "review",
        "design",
        "build",
        "qa_gate",
        "publish",
        "amplify",
        "measure"
      ]
    },
    "from_agent": {
      "enum": [
        "project-lead",
        "seo-strategist",
        "geo-specialist",
        "fact-checker",
        "copywriter",
        "visual-lead",
        "ux-conversion",
        "technical-seo",
        "analytics-lead",
        "digital-pr",
        "local-seo",
        "persona-reader",
        "qa-reviewer"
      ]
    },
    "to_agents": {
      "type": "array",
      "items": {
        "enum": [
          "project-lead",
          "seo-strategist",
          "geo-specialist",
          "fact-checker",
          "copywriter",
          "visual-lead",
          "ux-conversion",
          "technical-seo",
          "analytics-lead",
          "digital-pr",
          "local-seo",
          "persona-reader",
          "qa-reviewer"
        ]
      },
      "minItems": 1
    },
    "status": {
      "enum": [
        "draft",
        "ready_for_review",
        "changes_requested",
        "approved",
        "blocked"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "inputs_consumed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "artifact"
        ],
        "properties": {
          "artifact": {
            "type": "string"
          },
          "from_agent": {
            "type": "string"
          },
          "revision": {
            "type": "integer"
          }
        }
      }
    },
    "payload_type": {
      "enum": [
        "keyword_research",
        "ai_search_research",
        "fact_audit",
        "baseline",
        "content_brief",
        "review",
        "persona_review",
        "page_copy",
        "image_set",
        "design_spec",
        "build_report",
        "tracking_spec",
        "pr_plan",
        "geo_plan",
        "local_plan",
        "measurement_plan"
      ]
    },
    "payload": {
      "type": "object"
    },
    "self_qa": {
      "type": "object",
      "required": [
        "checklist",
        "results"
      ],
      "properties": {
        "checklist": {
          "type": "string"
        },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "check",
              "pass"
            ],
            "properties": {
              "check": {
                "type": "string"
              },
              "pass": {
                "type": "boolean"
              },
              "severity": {
                "enum": [
                  "blocker",
                  "major",
                  "minor"
                ]
              },
              "detail": {
                "type": "string"
              }
            }
          }
        },
        "scores": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 1,
            "maximum": 5
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "to",
          "question",
          "blocking"
        ],
        "properties": {
          "to": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "blocking": {
            "type": "boolean"
          }
        }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "payload_type": {
            "const": "keyword_research"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "payloads/keyword_research.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "payload_type": {
            "const": "ai_search_research"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "payloads/ai_search_research.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "payload_type": {
            "const": "fact_audit"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "payloads/fact_audit.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "payload_type": {
            "const": "baseline"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "payloads/baseline.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "payload_type": {
            "const": "content_brief"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "payloads/content_brief.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "payload_type": {
            "const": "review"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "payloads/review.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "payload_type": {
            "const": "persona_review"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "payloads/persona_review.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "payload_type": {
            "const": "page_copy"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "payloads/page_copy.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "payload_type": {
            "const": "image_set"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "payloads/image_set.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "payload_type": {
            "const": "design_spec"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "payloads/design_spec.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "payload_type": {
            "const": "build_report"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "payloads/build_report.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "payload_type": {
            "const": "tracking_spec"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "payloads/tracking_spec.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "payload_type": {
            "const": "pr_plan"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "payloads/pr_plan.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "payload_type": {
            "const": "geo_plan"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "payloads/geo_plan.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "payload_type": {
            "const": "local_plan"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "payloads/local_plan.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "payload_type": {
            "const": "measurement_plan"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "payloads/measurement_plan.schema.json"
          }
        }
      }
    }
  ]
}