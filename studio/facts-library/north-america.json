    {
      "fact": "Hawaii licence: how to apply",
      "value": "Apply online at emrs.ehawaii.gov and pay, then both partners meet a State-authorised agent together in person with government photo ID (passport accepted). No proxies.",
      "status": "confirmed",
      "source": "https://health.hawaii.gov/vitalrecords/marriage-licenses/",
      "source_tier": "government_or_tourism_board_source",
      "id_in_run": "studio/runs/north-america-20261029-0604:F024",
      "verified_on": "2026-10-29",
      "reverify_after": "2027-01-29"
    },
    {
      "fact": "Hawaii licence: timing",
      "value": "No waiting period once issued. Collect no sooner than 30 days before the ceremony; valid 30 days; valid only in Hawaii.",
      "status": "confirmed",
      "source": "https://health.hawaii.gov/vitalrecords/marriage-licenses/",
      "source_tier": "government_or_tourism_board_source",
      "id_in_run": "studio/runs/north-america-20261029-0604:F025",
      "verified_on": "2026-10-29",
      "reverify_after": "2027-01-29"
    },
    {
      "fact": "Hawaii licence: eligibility",
      "value": "No state residence or US citizenship requirement; no blood test; minimum age 18. Same steps for US, AU and UK passports.",
      "status": "confirmed",
      "source": "https://health.hawaii.gov/vitalrecords/marriage-licenses/",
      "source_tier": "government_or_tourism_board_source",
