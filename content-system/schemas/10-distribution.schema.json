{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Distribution payload",
  "type": "object",
  "required": ["pinterest", "instagram_carousel", "newsletter"],
  "properties": {
    "pinterest": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["title", "description", "image_slot", "link"], "properties": {"title": {"type": "string", "maxLength": 100}, "description": {"type": "string", "maxLength": 500}, "image_slot": {"type": "string"}, "board": {"type": "string"}, "link": {"type": "string"}}}},
    "instagram_carousel": {"type": "object", "required": ["slides", "caption"], "properties": {"slides": {"type": "array", "items": {"type": "string"}, "minItems": 3, "maxItems": 10}, "caption": {"type": "string", "maxLength": 2200}, "hashtags": {"type": "array", "items": {"type": "string"}}}},
    "newsletter": {"type": "object", "required": ["subject", "preview", "blurb", "link"], "properties": {"subject": {"type": "string", "maxLength": 70}, "preview": {"type": "string", "maxLength": 120}, "blurb": {"type": "string"}, "link": {"type": "string"}}}
  }
}
