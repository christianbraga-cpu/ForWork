{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Brief payload",
  "type": "object",
  "required": ["title", "primary_keyword", "audience", "reader", "goal", "service_link", "angle", "must_include", "avoid", "word_count", "categories", "content_type", "regional_scope"],
  "properties": {
    "title": {"type": "string"},
    "primary_keyword": {"type": "string"},
    "audience": {"type": "string", "description": "As given by the person"},
    "reader": {"type": "string", "description": "Sharpened reader definition"},
    "primary_persona": {"type": "string"},
    "journey_stage": {"enum": ["dreaming", "comparing", "deciding", "planning", "post-wedding"]},
    "goal": {"type": "string"},
    "service_link": {"type": "string"},
    "angle": {"type": "string"},
    "must_include": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "avoid": {"type": "array", "items": {"type": "string"}},
    "word_count": {"type": "array", "items": {"type": "integer"}, "minItems": 2, "maxItems": 2},
    "categories": {"type": "array", "items": {"type": "string"}, "minItems": 1, "description": "categories[0] is the PRIMARY category"},
    "tags": {"type": "array", "items": {"type": "string"}},
    "content_type": {"enum": ["destination_guide", "venue_feature", "planning_guide", "real_wedding", "cost_guide", "comparison", "inspiration", "other"]},
    "faq": {"type": "boolean"},
    "regional_scope": {"enum": ["global", "au_focus", "regional_versions"]},
    "cannibalisation_check": {"type": "string"}
  }
}
